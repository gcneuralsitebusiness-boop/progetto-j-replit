{
  "name": "@workspace/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --config playwright.config.ts",
    "test:report": "playwright show-report playwright-report",
    "install-browsers": "playwright install chromium && patchelf --add-rpath \"$HOME/.nix-profile/lib\" \"$HOME/workspace/.cache/ms-playwright/chromium_headless_shell-$(node -e 'const {chromium}=require(\"@playwright/test/lib/server/browser/chromium.js\");console.log(chromium.name())' 2>/dev/null || echo 1234)/chrome-headless-shell-linux64/chrome-headless-shell\""
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
